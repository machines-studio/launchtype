{
  "name": "launchtype",
  "version": "2.0.0",
  "description": "launchpad + type case",
  "scripts": {
    "start": "concurrently \"npm:server\" \"npm:vite\" -c gray,green",
    "server": "cross-env NODE_ENV=development node server",
    "vite": "vite",
    "build": "vite build --emptyOutDir",
    "preview": "vite preview --open",
    "cables:pull": "node scripts/cables.mjs",
    "test": "vite --mode test",
    "deploy": "vite build && ghp build --a .github -f -b production -m 'Deploy to production'",
    "deploy:staging": "vite build --mode staging && ghp build -a .github -f -b staging -m 'Deploy to staging'",
    "postversion": "git push && git push --tags && npm run deploy"
  },
  "author": "Arnaud Juracek",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tooooools/boilerplate.git"
  },
  "devDependencies": {
    "@cables/cables": "^0.23.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.23.0",
    "ghp": "^1.7.0",
    "glob": "^11.0.3",
    "neostandard": "^0.12.1",
    "sass": "^1.59.3",
    "stylelint": "^15.3.0",
    "stylelint-config-standard-scss": "^7.0.1",
    "stylelint-order": "^6.0.3",
    "stylelint-scss": "^4.5.0",
    "vite": "^4.2.1"
  },
  "dependencies": {
    "@internet/raf": "^0.2.1",
    "@tooooools/ui": "^2.0.0-alpha.1",
    "@tooooools/utils": "^1.4.3",
    "animejs": "^4.0.2",
    "chalk": "^5.4.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.2.0",
    "fs-extra": "^11.3.0",
    "howler": "^2.2.4",
    "iconoir": "^7.11.0",
    "missing-math": "^3.4.0",
    "multer": "^2.0.2",
    "object-hash": "^3.0.0",
    "reconnectingwebsocket": "^1.0.0",
    "smooth-polyline": "^1.0.8",
    "uid": "^2.0.2",
    "ws": "^8.18.3"
  }
}
